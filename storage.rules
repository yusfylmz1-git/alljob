rules_version = '2';

// Usta Cepte — Cloud Storage güvenlik kuralları.
//
// Model: pazaryeri görselleri (profil fotoğrafı, iş galerisi, ilan fotoğrafı,
// sertifika, sohbet fotoğrafı) KAMUYA AÇIK içeriktir — misafir de Keşfet'te
// ustaları/ilanları görür. Bu yüzden OKUMA herkese açık.
// YAZMA yalnızca oturum açmış kullanıcıya; ayrıca sunucu tarafında da tür/boyut
// sınırı (istemci image_picker ile küçültse de savunma katmanı).
//
// Yollar (bkz. FirebaseStorageRepository): profile/, work/, job/, certificate/, chat/
service firebase.storage {
  match /b/{bucket}/o {
    // Ortak: geçerli bir görsel yükleme mi? (≤6 MB).
    // SVG/HTML image/* XSS riski → yalnız yaygın raster formatlar (S-STOR-1).
    function isValidImage() {
      return request.resource != null
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches(
            'image/(jpeg|jpg|png|webp|gif|heic|heif)');
    }

    // Platform marka varlıkları (logo vb.) — herkes okur; yalnız admin yazar.
    // Yol: platform/{uid}/{dosya} — uid = yükleyen admin (denetim izi).
    match /platform/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.get('admin', false) == true
        && isValidImage();
    }

    // Sertifika/belge — ÖZEL. Usta buraya ustalık belgesi, diploma, hatta
    // kimlik fotokopisi yükleyebiliyor: KVKK'da özel nitelikli veri sınıfına
    // girer ve herkese açık olamaz. Yol tahmin edilebilir yapıda
    // (certificate/{uid}/{dosya}) ve uid herkese açık olduğu için "URL'yi
    // kimse bilmez" savunması geçersizdi.
    //
    // Müşteri güven sinyalini KAYBETMEZ: `artisanProfiles.certificateStatus`
    // herkese açık okunur, yani profilde "Belgeleri onaylanmış" rozeti
    // görünmeye devam eder — yalnız belgenin KENDİSİ açılamaz.
    // Bu match, aşağıdaki genel {folder} kuralından ÖNCE gelir ve daha
    // dar olduğu için sertifika okumasını o kural açamaz (Storage'da
    // kurallar OR'lanır → genel kuraldan 'certificate' çıkarılmıştır).
    match /certificate/{uid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || request.auth.token.get('admin', false) == true);
      allow write: if request.auth != null
        && request.auth.uid == uid
        && isValidImage();
    }

    // Yeni yükleme yolu: {klasör}/{uid}/{dosya} — herkes yalnızca KENDİ uid
    // klasörüne yazabilir (başkasının görselini ezme/istenmeyen klasör yok).
    // 'certificate' bu listede YOKTUR: yukarıdaki özel kural yönetir.
    match /{folder}/{uid}/{fileName} {
      // ⚠️ Storage'da eşleşen TÜM kurallar OR'lanır: bu desen
      // `certificate/{uid}/{dosya}` yoluna DA uyar. `if true` bırakılırsa
      // yukarıdaki özel sertifika kuralı hiçbir işe yaramaz — okuma yine
      // herkese açılırdı. Bu yüzden okuma da klasör listesiyle sınırlı.
      allow read: if folder in ['profile', 'work', 'job', 'chat', 'product'];
      allow write: if request.auth != null
        && request.auth.uid == uid
        && folder in ['profile', 'work', 'job', 'chat', 'product']
        && isValidImage();
    }

    // Eski düz yol ({klasör}/{dosya}): mevcut görseller okunmaya devam eder,
    // ancak bu yola YENİ yazım kapalıdır (sahiplik kanıtlanamaz).
    // Sertifika burada da dışarıda: eski düz yola yüklenmiş bir belge varsa
    // o da herkese açık olmamalı.
    match /{folder}/{fileName} {
      allow read: if folder != 'certificate';
      allow write: if false;
    }
  }
}
