rules_version = '2';

// Usta Cepte — Firestore güvenlik kuralları (PRD §5).
// Dağıtım: `firebase deploy --only firestore:rules`
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Yönetici mi? Kaynak: Auth custom claim `admin:true` (yalnız CF yazar).
    // `.get` — claim yokken undefined hatası olmasın (bkz. isSuspended).
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.get('admin', false) == true;
    }
    // Süper yönetici mi? (RBAC — davet PII, staff işlemleri).
    function isSuperAdmin() {
      return isAdmin()
        && request.auth.token.get('role', '') == 'superadmin';
    }
    // Askıya alınmış kullanıcı mı? Kaynak: Auth custom claim `suspended:true`
    // (yalnız `adminSetUserSuspended` CF yazar). Askıya alınan hesap yeni
    // içerik (iş/teklif/mesaj/değerlendirme) OLUŞTURAMAZ — okuma serbest.
    //
    // ÖNEMLİ: `request.auth.token.suspended` doğrudan okunursa claim YOKKEN
    // Rules "Property suspended is undefined" hatası verir → tüm create
    // kuralları (ilan/teklif/mesaj/yorum) reddedilir. `.get(..., false)` kullan.
    function isSuspended() {
      return isSignedIn()
        && request.auth.token.get('suspended', false) == true;
    }

    // E-posta doğrulanmış mı? Kaynak: Firebase Auth token `email_verified`
    // (kayıt sonrası bağlantı veya Google ile genelde true). `.get` — alan
    // yokken hata vermesin. İlan açma + ilan üzerinden usta iletişimi
    // (teklif/ilgi) için zorunlu.
    function isEmailVerified() {
      return isSignedIn()
        && request.auth.token.get('email_verified', false) == true;
    }

    // users — herkes okuyabilir (profil adı/foto herkese açık); yalnızca sahibi yazar.
    //
    // GÜVENLİK: Firestore alan-bazlı okuma kısıtlaması yapamaz — okuma izni
    // varsa TÜM döküman döner. Bu yüzden HASSAS iletişim bilgileri (telefon
    // numarası vb.) bu herkese açık dökümana KONULAMAZ; owner dahil kimse
    // `phoneNumber` yazamaz (aşağıdaki `!hasAny` guard'ı). Hassas veri, yalnızca
    // sahibinin okuyabildiği `users/{uid}/private/*` alt-koleksiyonuna yazılır.
    match /users/{uid} {
      // Owner yazamaz: phoneNumber, email, fcmTokens (H2) + moderasyon aynası
      // (suspended/suspendedAt) — yalnız CF yazar; kullanıcı kendini açamaz.
      // email/fcmTokens: create'te yasak; update'te yalnız SİLME (legacy temizlik).
      //
      // MÜŞTERİ SAYAÇLARI (completedJobsAsCustomer, reviewCountAsCustomer,
      // ratingAsCustomer):
      // profil sadeleştirmesiyle herkese açık dokümana taşındı; yalnız CF
      // yazar (onJobWritten / onReviewWritten). İstemci yazabilseydi kendi
      // "tamamlanan iş" sayısını şişirirdi (CLAUDE.md kural 3).
      function notSettingPublicPii() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny(['phoneNumber', 'suspended', 'suspendedAt',
                                'completedJobsAsCustomer',
                                'reviewCountAsCustomer',
                                'ratingAsCustomer'])
          && (!changed.hasAny(['email'])
              || !('email' in request.resource.data))
          && (!changed.hasAny(['fcmTokens'])
              || !('fcmTokens' in request.resource.data));
      }

      // displayName: istemci Validators.displayName ile hizalı uzunluk tavanı.
      // Karakter sınıfı (yalnız harf…) Rules'ta Unicode ile kısıtlı; istemci
      // + repo katmanı `***"""` gibi isimleri reddeder.
      function displayNameOk() {
        return request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 3
          && request.resource.data.displayName.size() <= 60;
      }

      // ORTAK PROFİL ALANLARI (2026-08-08) — publicPhone / socialLinks /
      // aboutText. Kullanıcının BİLEREK yayınladığı bilgiler; yasaklı
      // `phoneNumber` ile karıştırılmamalı (o hassas, private/contact'ta).
      //
      // Yalnız tip ve uzunluk tavanı doğrulanır: içerik denetimi istemcide
      // (Validators) ve moderasyonda. Tavan olmadan bir kullanıcı dökümana
      // megabaytlarca metin yazıp okuma maliyetini herkese ödetebilirdi.
      //
      // publicPhone BİÇİM ŞARTI (2026-08-18): SMS doğrulaması kaldırılınca
      // numara elle giriliyor. İstemci `normalizeTrMobile()` ile her zaman
      // E.164 yazar (`phone_format.dart`); kural aynı biçimi ZORUNLU kılar.
      // Aksi hâlde doğrudan SDK çağrısıyla bu alana serbest metin (reklam,
      // bağlantı, başkasının numarası) yazılabilirdi — alan herkese açık
      // okunuyor ve sohbetteki WhatsApp düğmesini besliyor.
      function profileFieldsOk() {
        let d = request.resource.data;
        return (!('publicPhone' in d)
                || d.publicPhone == null
                || d.publicPhone == ''
                || (d.publicPhone is string
                    && d.publicPhone.matches('^\\+905[0-9]{9}$')))
          && (!('aboutText' in d)
                || (d.aboutText is string && d.aboutText.size() <= 1000))
          && (!('socialLinks' in d)
                || d.socialLinks == null
                || d.socialLinks is map);
      }

      allow read: if true;
      // create'te resource null olduğundan doğrudan yazılan anahtarlara bakılır.
      allow create: if isSelf(uid)
        && !request.resource.data.keys()
              .hasAny(['phoneNumber', 'suspended', 'suspendedAt',
                       'email', 'fcmTokens',
                       // Sayaçlar sıfırdan başlar; CF yazar (kural 3).
                       'completedJobsAsCustomer', 'reviewCountAsCustomer',
                       'ratingAsCustomer'])
        && displayNameOk()
        && profileFieldsOk();
      allow update: if isSelf(uid)
        && notSettingPublicPii()
        && profileFieldsOk()
        && (!request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['displayName'])
            || displayNameOk());
      allow delete: if false;

      // Hassas/özel kullanıcı verisi — YALNIZCA sahibi okur/yazar.
      // contact: telefon; push: fcmTokens[] + prefs (H2);
      // chatMeta: denormalize sohbet okunmamış sayacı (alt bar rozeti).
      // Başka docId yok (rastgele private/* şişirmesi / PII sızıntı yüzeyi kapanır).
      // `jobStats` (açık ilan sayacı) ve `productStats` (taslak sayacı)
      // LİSTEDE YOK: yalnız CF yazar (onJobWritten / onProductWritten).
      // İstemci yazabilseydi sayacı sıfırlayıp kotayı kendi kaldırırdı.
      // Okuma sahibine açık — UI kalan hakkı gösterebilsin.
      // `rating` de CF'e ait: usta→müşteri puanı (a2c) burada tutulur.
      match /private/{doc} {
        allow read: if isSelf(uid);
        allow write: if isSelf(uid) && doc in ['contact', 'push', 'chatMeta'];
      }

      // Engellenen kullanıcılar (UGC politikası) — YALNIZCA sahibi okur/yazar.
      // Engellenen kişi engellendiğini GÖREMEZ; mesaj kuralı bu koleksiyona
      // `exists` ile bakarak engellenenin mesaj yazmasını sunucuda reddeder.
      match /blocked/{otherUid} {
        allow read, write: if isSelf(uid);
      }

      // Uygulama içi bildirim merkezi — kayıtları YALNIZCA Cloud Functions
      // yazar (Admin SDK kuralları aşar). Sahibi okur ve sadece `read`
      // alanını true yapabilir; sahte bildirim enjekte EDİLEMEZ.
      //
      // SİLME sahibine açıktır (2026-08-10, "bildirimleri temizle"):
      // `create` kapalı kaldığı sürece silme sahtecilik yolu açmaz — kendi
      // gelen kutusunu temizlemek kullanıcının hakkıdır. Bildirim zaten
      // türetilmiş veridir (kaynak sohbet/ilan kaydı yerinde durur), yani
      // silinmesi denetim izi kaybettirmez.
      match /notifications/{notifId} {
        allow read: if isSelf(uid);
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if isSelf(uid);
        allow create: if false;
      }
    }

    // artisanProfiles — herkese açık (misafir de görebilir, PRD §2); sahibi yazar.
    // Puanlama alanları yalnızca Cloud Functions (Admin SDK) tarafından yazılır.
    // `isPremium/premiumExpiresAt` da İSTEMCİDEN YAZILAMAZ (tek gelir modeli
    // premium — istemci kendine bedava premium yazamamalı). Beta süresince
    // premium ÖZELLİKLERİ herkese açık (istemcide AppConstants bayrağı);
    // gerçek satın alma gelince bu alanları yalnız sunucu (CF) yazacak.
    // Create ve update ayrı: create'te `resource` null olduğu için diff yerine
    // doğrudan yazılan anahtarlara bakılır (null.data erişimi kuralı hataya
    // düşürüp ilk kaydı reddediyordu).
    // `isVerified` (mavi tik) ve platform onayı yalnız Cloud Functions (Admin SDK)
    // tarafından yazılır — usta kendini keyfî olarak "mavi tikli" yapamaz.
    match /artisanProfiles/{uid} {
      // emailVerified aynası: true yalnız token email_verified iken.
      function emailVerifiedMirrorOk() {
        return request.resource.data.get('emailVerified', false) != true
          || request.auth.token.get('email_verified', false) == true;
      }
      // Deneyim 0..60; hakkımda en fazla 500 karakter (istemci ile hizalı).
      function profileContentOk() {
        let years = request.resource.data.get('experienceYears', 0);
        let about = request.resource.data.get('aboutText', '');
        return years is int
          && years >= 0
          && years <= 60
          && about is string
          && about.size() <= 500
          && socialLinksOk()
          && serviceProvincesOk();
      }

      // Hemen Lazım il eşleşmesinin dayandığı alan. serviceAreas'tan türetilir
      // (her il en az bir hizmet bölgesinden gelir) → boyutu onu AŞAMAZ.
      // Böylece usta tek bölge seçip 81 il yazarak tüm ülkenin Hemen Lazım
      // ilanlarına teklif veremez. Alan yoksa geçerli (eski profiller).
      function serviceProvincesOk() {
        let d = request.resource.data;
        let provs = d.get('serviceProvinces', []);
        let areas = d.get('serviceAreas', []);
        return !('serviceProvinces' in d)
          || (provs is list
              && areas is list
              && provs.size() <= areas.size());
      }

      // Sosyal bağlantılar: yalnız bilinen anahtarlar, her biri string|null ve
      // makul uzunlukta. Web sitesi http(s) olmak zorunda; kullanıcı adlarına
      // URL/boşluk yazılamaz (istemci normalize eder, kural burada zorlar).
      function socialLinksOk() {
        let s = request.resource.data.get('socialLinks', {});
        return !('socialLinks' in request.resource.data)
          || (s is map
              && s.keys().hasOnly(['instagram','youtube','tiktok',
                                   'whatsapp','website'])
              && handleOk(s.get('instagram', null))
              && handleOk(s.get('youtube', null))
              && handleOk(s.get('tiktok', null))
              && handleOk(s.get('whatsapp', null))
              && websiteOk(s.get('website', null)));
      }
      function handleOk(v) {
        return v == null
          || (v is string && v.size() <= 60 && !v.matches('.*[/\\\\s].*'));
      }
      function websiteOk(v) {
        return v == null
          || (v is string && v.size() <= 200 && v.matches('https?://.*'));
      }

      allow read: if true;
      // adminVerified / isVerified / featured / moderationHidden yalnız CF (moderasyon).
      // Premium + moderasyon + skor: yalnız CF. premiumProductId/premiumUpdatedAt
      // de istemciden yazılamaz (yanlış abonelik id enjekte etmesin).
      allow create: if isSelf(uid)
        && !request.resource.data.keys()
              .hasAny(['averageRating','totalReviews','totalRatingSum',
                       'topTags','tagCounts',
                       'completedJobs','isPremium','premiumExpiresAt',
                       'premiumProductId','premiumUpdatedAt',
                       'isVerified','adminVerified','featured','moderationHidden',
                       'moderatedBy','moderatedAt',
                       // Belge inceleme sonucu: yalnız CF yazar. Aksi hâlde
                       // usta kendini "belgeli usta" ilan ederdi.
                       'certificateStatus','certificateNote',
                       'certificateReviewedBy','certificateUpdatedAt'])
        && emailVerifiedMirrorOk()
        && profileContentOk();
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['averageRating','totalReviews',
                       'totalRatingSum','topTags','tagCounts','completedJobs',
                       'isPremium','premiumExpiresAt',
                       'premiumProductId','premiumUpdatedAt',
                       'isVerified','adminVerified','featured','moderationHidden',
                       'moderatedBy','moderatedAt',
                       // Belge inceleme sonucu: yalnız CF yazar (usta belge
                       // listesini değiştirince trigger pending'e döndürür).
                       'certificateStatus','certificateNote',
                       'certificateReviewedBy','certificateUpdatedAt'])
        && emailVerifiedMirrorOk()
        && profileContentOk();
      allow delete: if false;
    }

    // chats — yalnızca katılımcılar okuyabilir/yazabilir.
    //
    // Üyelik, `members: {uid: true}` HARİTASI ile kontrol edilir. Liste
    // sorgusu `where('members.<uid>', '==', true)` eşitlik filtresi kullanır;
    // kural motoru bu ispatı garantili yapar (array-contains + `in` ispatı
    // sorgularda PERMISSION_DENIED üretebiliyordu). `participants` dizisi
    // eski dökümanlarla uyum ve veri modeli için durmaya devam eder.
    match /chats/{chatId} {
      // members veya participants ile üyelik. Eksik alanlarda kural motoru
      // hataya düşmesin diye `.keys().hasAny` + tip kontrolü.
      function isMember(data) {
        return isSignedIn()
          && (
            (data.keys().hasAny(['members'])
              && data.members is map
              && data.members.get(request.auth.uid, false) == true)
            || (data.keys().hasAny(['participants'])
              && data.participants is list
              && request.auth.uid in data.participants)
          );
      }

      // Update'te yalnız sohbet meta alanları (H1). Kimlik alanları
      // (customerUid/artisanUid/participants/adlar) değişemez.
      // members: yalnız legacy heal — tam olarak iki taraf, üçüncü yok.
      //
      // `lockedAt` / `lockReason` / `jobId` / `jobTitle` LİSTEDE YOK: kilidi
      // yalnız CF (Admin SDK) koyar/kaldırır — aksi halde usta kendi sohbetinin
      // kilidini açıp başka usta seçilmiş işte mesaj yazmaya devam ederdi.
      function chatUpdateKeysOk() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageSenderUid', 'updatedAt',
                    'lastRead', 'clearedAt', 'members',
                    'archivedBy', 'pinnedBy', 'customerStarted'])
          && personalFlagsOk('archivedBy')
          && personalFlagsOk('pinnedBy')
          && customerStartedOk();
      }

      // `customerStarted` yalnız MÜŞTERİ tarafından ve yalnız false→true
      // yazılabilir. Usta bu bayrağı yazabilseydi kendi yazma iznini kendisi
      // açardı; müşteri de geri alıp ustayı susturamaz.
      function customerStartedOk() {
        return !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['customerStarted'])
          || (request.auth.uid == resource.data.get('customerUid', '')
              && request.resource.data.customerStarted == true);
      }

      // Arşiv/sabitleme KİŞİSELDİR: kullanıcı yalnız KENDİ anahtarını
      // değiştirebilir. Karşı tarafın sohbetini arşivleyemez/sabitleyemez.
      // İstisna: mesaj gönderen taraf, ALICI'nın arşiv bayrağını yalnız
      // false yapabilir (yeni mesaj sohbeti arşivden çıkarır).
      function personalFlagsOk(field) {
        return !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny([field])
          || (request.resource.data[field] is map
              && request.resource.data[field].diff(
                   resource.data.get(field, {})).affectedKeys()
                 .hasOnly([request.auth.uid])
              )
          || (field == 'archivedBy'
              && unarchiveForOtherOk());
      }
      // Karşı tarafın arşivini yalnız SIFIRLAMAYA (false) izin verilir: yeni
      // mesaj gelince sohbet alıcının arşivinden çıkar. Değişen tek anahtar
      // karşı tarafın uid'i olmalı ve yeni değeri false — böylece kimse
      // başkasının sohbetini arşive GÖMEMEZ.
      //
      // Sohbette yalnız iki taraf var, o yüzden "karşı taraf" doğrudan
      // hesaplanır (Set indekslenemediği için hasOnly ile eşleştiriyoruz).
      function unarchiveForOtherOk() {
        let other = request.auth.uid == resource.data.customerUid
          ? resource.data.artisanUid
          : resource.data.customerUid;
        return request.resource.data.archivedBy.diff(
              resource.data.get('archivedBy', {})).affectedKeys()
                .hasOnly([other])
          && request.resource.data.archivedBy.get(other, false) == false;
      }
      function chatMembersHealOk() {
        return !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['members'])
          || (request.resource.data.members is map
              && resource.data.customerUid is string
              && resource.data.artisanUid is string
              && request.resource.data.members[resource.data.customerUid] == true
              && request.resource.data.members[resource.data.artisanUid] == true
              && request.resource.data.members.keys()
                  .hasOnly([resource.data.customerUid, resource.data.artisanUid]));
      }

      // get: döküman YOKSA (resource == null) oturum açmış kullanıcı var/yok
      // kontrolü yapabilsin — aksi halde startChat'in get()'i permission-denied
      // verir ve sohbet hiç oluşmaz. Var olan döküman yalnız üyeye.
      // list: yalnız üye olduğu dökümanlar (members.<uid> sorgusu).
      allow get: if isSignedIn()
        && (resource == null || isMember(resource.data));
      allow list: if isMember(resource.data);
      // Create: deterministik ID + çağıran taraf + 2 kişilik members.
      //
      // ID BİÇİMİ (S-CHAT-1 spam koruması — rastgele ID ile üçüncü kişiye
      // sohbet açılamaz):
      //   chat_{uidA}__{uidB}            → uidA/uidB = iki taraf
      //   chat_{uidA}__{uidB}__{jobId}   → eski ilan bazlı kayıtlar
      //
      // İKİ SIRA DA KABUL EDİLİR (2026-08-10). İstemci kimliği artık
      // ALFABETİK sıralıyor (`chatIdFor`), çünkü rol giriş noktasına göre
      // değişiyordu ve aynı çift iki ayrı kutu açıyordu. Kural yalnız
      // müşteri__usta sırasını kabul etseydi, ustanın uid'i önce gelen her
      // çiftte sohbet OLUŞTURULAMAZDI.
      //
      // Spam koruması korunur: kimlik yine tam olarak İKİ TARAFIN uid'ine
      // çakılıdır, yalnızca sıra serbesttir. Üçüncü kişi kimliğe giremez.
      allow create: if isSignedIn()
        && !isSuspended()
        && isEmailVerified()
        && request.resource.data.customerUid is string
        && request.resource.data.artisanUid is string
        && request.resource.data.customerUid != request.resource.data.artisanUid
        && (request.auth.uid == request.resource.data.customerUid
            || request.auth.uid == request.resource.data.artisanUid)
        && (chatId == 'chat_' + request.resource.data.customerUid
              + '__' + request.resource.data.artisanUid
            || chatId == 'chat_' + request.resource.data.artisanUid
              + '__' + request.resource.data.customerUid
            || chatId.matches('^chat_' + request.resource.data.customerUid
              + '__' + request.resource.data.artisanUid + '__.+$')
            || chatId.matches('^chat_' + request.resource.data.artisanUid
              + '__' + request.resource.data.customerUid + '__.+$'))
        // Yeni sohbet KİLİTLİ ya da "müşteri başlattı" olarak doğamaz.
        && request.resource.data.get('customerStarted', false) == false
        && !request.resource.data.keys().hasAny(['lockedAt', 'lockReason'])
        && request.resource.data.members is map
        && request.resource.data.members[request.resource.data.customerUid] == true
        && request.resource.data.members[request.resource.data.artisanUid] == true
        && request.resource.data.members.keys()
            .hasOnly([request.resource.data.customerUid,
                      request.resource.data.artisanUid])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll(
            [request.resource.data.customerUid,
             request.resource.data.artisanUid]);
      // Update: üye + askıda değil (okundu/meta).
      allow update: if isMember(resource.data)
        && !isSuspended()
        && chatUpdateKeysOk()
        && chatMembersHealOk();
      allow delete: if false;

      match /messages/{msgId} {
        // Sohbet dökümanı yoksa get().data kural motorunu hataya düşürür;
        // önce exists — yoksa net false (permission-denied yerine okunabilir ret).
        function memberOfChat() {
          let path = /databases/$(database)/documents/chats/$(chatId);
          return exists(path) && isMember(get(path).data);
        }

        // Karşı taraf, göndereni ENGELLEDİYSE mesaj oluşturulamaz (UGC
        // politikası). Aynı chat dökümanına ikinci get() SAYILMAZ (kural
        // motoru aynı isteğin tekrar okumalarını önbellekler). Eski
        // dökümanlarda customerUid/artisanUid yoksa kontrol atlanır
        // (boş yolla exists() kuralı hataya düşürmesin).
        function recipientBlockedSender() {
          let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
          let other = chat.get('customerUid', '') == request.auth.uid
              ? chat.get('artisanUid', '')
              : chat.get('customerUid', '');
          return other != ''
            && exists(/databases/$(database)/documents/users/$(other)/blocked/$(request.auth.uid));
        }

        // Metin boyutu (spam / maliyet) — foto yalnız imageHandle ile.
        // `moderationHidden` / `moderatedBy` / `moderatedAt` bilerek YOK:
        // yalnız CF (adminModerateMessage) yazar. hasOnly listesinde
        // olmadığından istemci bunları oluşturma anında da ekleyemez
        // (kendini "kaldırılmamış" ilan edemez).
        // `type` allowlist'te YOK: sistem mesajını (yaşam döngüsü şeridi)
        // yalnız CF yazar. İstemci yazabilseydi "Usta seçildi" gibi resmî
        // görünen sahte bildirimler üretebilirdi.
        function messagePayloadOk() {
          let t = request.resource.data.get('text', null);
          return (t == null || (t is string && t.size() <= 4000))
            && (!('imageHandle' in request.resource.data)
                || request.resource.data.imageHandle is string
                || request.resource.data.imageHandle == null)
            && request.resource.data.keys()
                .hasOnly(['senderUid', 'text', 'imageHandle', 'createdAt',
                          'deleted']);
        }

        // SERBEST PAZARYERI (2026-08-08): iki taraf da yazabilir.
        //
        // Eskiden "iletişimi müşteri başlatır" kuralı vardı: usta, müşteri
        // yazana kadar (`customerStarted`) mesaj gönderemezdi — spam
        // korumasıydı. Kullanıcı kararıyla kaldırıldı; karşılıklı serbest
        // mesajlaşma isteniyor.
        //
        // Kötüye kullanıma karşı KALAN korumalar: kilit (`lockedAt`),
        // engelleme (`recipientBlockedSender`), askıya alma (`isSuspended`),
        // şikayet + admin moderasyonu.
        //
        // `customerStarted` bayrağı KALDI — sohbet listesi/UI onu hâlâ
        // "müşteri konuşmaya başladı mı" bilgisi olarak kullanıyor.
        function senderMayWrite() {
          let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
          return chat.get('lockedAt', null) == null;
        }

        // SUNUCU TARAFI HIZ SINIRI (2026-08-14).
        //
        // İstemcide `minMessageInterval` (1.2 sn) ve `maxMessagesPerMinute`
        // vardı ama istemci koruması ATLATILABİLİR: doğrudan SDK çağrısı
        // yapan biri saniyede yüzlerce mesaj yazabilir → Firestore yazma +
        // her mesajda tetiklenen push CF'si (onMessageCreated) fatura ve
        // taciz riski demek.
        //
        // Nasıl çalışır: `createdAt` sunucu zaman damgası olmak ZORUNDA
        // (istemci geçmiş tarih yazıp sınırı atlayamasın) ve sohbetin
        // `updatedAt` alanından en az 1 saniye SONRA olmalı. `updatedAt`
        // her mesajda güncellendiği için pratikte "aynı sohbete saniyede
        // en fazla 1 mesaj" anlamına gelir.
        //
        // Neden 1 sn: istemci tavanı 1.2 sn; kural biraz gevşek tutuldu ki
        // ağ gecikmesi normal kullanıcıyı yanlışlıkla engellemesin.
        //
        // ⚠️ `chats/{chatId}.updatedAt` yoksa (eski/iskelet doküman) kural
        // sınır uygulamaz — mevcut sohbetler kilitlenmesin.
        function messageRateOk() {
          let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
          let son = chat.get('updatedAt', null);
          return request.resource.data.createdAt == request.time
            && (son == null || request.time > son + duration.value(1, 's'));
        }

        allow read: if memberOfChat();
        // Yalnızca gönderen kendi mesajını oluşturabilir; alıcı göndereni
        // engellediyse veya sohbet kilitliyse oluşturamaz.
        allow create: if isSignedIn()
          && !isSuspended()
          && request.resource.data.senderUid == request.auth.uid
          && memberOfChat()
          && senderMayWrite()
          && !recipientBlockedSender()
          && messageRateOk()
          && messagePayloadOk();
        // Yumuşak silme: YALNIZ gönderen, YALNIZ `deleted=true` + içerik
        // alanlarının kaldırılması şeklinde güncelleyebilir (mesaj içeriği
        // değiştirilemez, başkasının mesajı silinemez, silme geri alınamaz).
        // affectedKeys hasOnly → `moderationHidden` istemciden DEĞİŞTİRİLEMEZ
        // (yönetici kararı geri alınamaz). Ayrıca yönetici kaldırdıysa
        // gönderen üstüne "silindi" yazıp etiketi değiştiremesin diye
        // kaldırılmış mesajda güncelleme tamamen kapalı.
        allow update: if isSignedIn()
          && resource.data.senderUid == request.auth.uid
          && resource.data.get('moderationHidden', false) != true
          && request.resource.data.deleted == true
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'text', 'imageHandle'])
          && !request.resource.data.keys().hasAny(['text', 'imageHandle']);
        allow delete: if false;
      }
    }

    // reviews — herkes okuyabilir. Oluşturma/güncelleme SUNUCUDA doğrulanır:
    //  - Yazan, dökümandaki müşteri olmalı (customerUID == auth.uid).
    //  - Döküman ID'si deterministik: chat_{müşteriUid}__{ustaUid} → müşteri
    //    başına usta başına TEK döküman; ikinci değerlendirme AYNI dökümanı
    //    GÜNCELLER (puan şişirme yine kapalı: sayaç artmaz, delta işlenir).
    //  - Aynı ID'li sohbet dökümanı VAR olmalı (PRD §5 "sohbet geçmişi şartı"
    //    artık kuralda; istemcideki kontrol yalnızca UX).
    //  - Kendini değerlendirmek yasak; puan 1..5 tam sayı.
    // delete kapalı → `onReviewWritten` CF toplamları delta ile güvenle tutar.
    match /reviews/{reviewId} {
      // KİŞİ BAZLI (2026-08-08): herkes herkesi değerlendirebilir.
      //
      // Kimlik `rev_{yazan}__{hedef}` — ÇİFTE çakılı. "Bir kişiye bir
      // değerlendirme" kısıtını kimliğin kendisi taşır: ikinci yazım aynı
      // dokümana düşer, yani create değil update olur ve update kuralı
      // yalnız YAZANA izin verir. Ayrı bir "daha önce yazmış mı" sorgusu
      // gerekmez.
      //
      // ESKİ `chat_*` kimlikli kayıtlar okunmaya devam eder; aşağıdaki
      // create kalıbı yalnız YENİ yazımları bağlar.
      //
      // ⚠️ KALDIRILAN KOŞUL: eskiden "iş tamamlanmış olmalı" (job.status in
      // ['completed','rated']) şartı vardı. İş akışı kaldırılınca hiçbir ilan
      // o duruma geçmez oldu → değerlendirme fiilen KİLİTLENMİŞTİ.
      function isA2C() {
        return request.resource.data.get('direction', 'c2a') == 'a2c';
      }
      // Yazan taraf, yöne göre doğru alanda mı?
      function reviewAuthorOk() {
        return isA2C()
          ? request.resource.data.artisanUID == request.auth.uid
          : request.resource.data.customerUID == request.auth.uid;
      }
      // Hedef = yazanın KARŞISINDAKİ alan.
      function reviewTargetUid() {
        return isA2C()
          ? request.resource.data.customerUID
          : request.resource.data.artisanUID;
      }
      // Kimlik, yazan+hedef çiftine ÇAKILI: başkasının adına ya da rastgele
      // bir kimlikle değerlendirme yazılamaz.
      function reviewIdOk() {
        return reviewId == 'rev_' + request.auth.uid + '__' + reviewTargetUid();
      }
      // H5: herkes okur; gizlenenler istemcide elenir (alan bazlı filter yok).
      // Admin gizleme bayrağını okuyabilir; istemci hiddenByAdmin==true olanı göstermez.
      allow read: if true;
      // Alan allowlist'i ZORUNLU: `reviews` herkese açık okunur ve usta
      // profilinde listelenir. Allowlist olmadan (a) istemci `hiddenByAdmin`
      // gibi YALNIZ CF'e ait moderasyon alanlarını ilk yazımda enjekte
      // edebiliyordu, (b) doküman boyutuna tavan olmadığı için tek yoruma
      // yüzlerce KB metin konup her profil görüntüleyene indirtilebiliyordu.
      // Modelin yazdığı alanlar: review.dart `toMap()` (8 alan).
      allow create: if isSignedIn()
        && !isSuspended()
        && request.resource.data.keys().hasOnly([
             'artisanUID', 'customerUID', 'customerDisplayName',
             'chatId', 'rating', 'tags', 'direction', 'createdAt'
           ])
        && request.resource.data.customerUID is string
        && request.resource.data.artisanUID is string
        && request.resource.data.customerUID != request.resource.data.artisanUID
        && reviewAuthorOk()
        && reviewIdOk()
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        // Etiketler hazır listeden gelir (ReviewTags) — serbest metin değil.
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 8
        && request.resource.data.customerDisplayName is string
        && request.resource.data.customerDisplayName.size() <= 60;
      // Güncelleme: YALNIZ değerlendirmeyi YAZAN taraf (yöne göre müşteri ya
      // da usta); kimlik alanları (customerUID/artisanUID/chatId/direction)
      // değiştirilemez, puan yine 1..5 int.
      allow update: if isSignedIn()
        && (resource.data.get('direction', 'c2a') == 'a2c'
            ? resource.data.artisanUID == request.auth.uid
            : resource.data.customerUID == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'tags', 'createdAt', 'customerDisplayName'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if false;
    }

    // neighborhoods — lazy loading ile okunur (PRD §3); yazım yönetici/CF'e ait.
    match /neighborhoods/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Verilen güncellemede yalnızca [keys] alanları mı değişti?
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // jobs — müşterinin açtığı ilan. Bir DUYURUDUR: usta ilan sahibine
    // doğrudan mesaj atar, anlaşma taraflar arasındadır.
    //
    // Okuma: HERKES (Keşfet "İş İlanları" paneli misafire de açık; ilanlar
    // pazaryeri gereği kamuya açık içeriktir).
    //
    // Eskiden burada usta seçimi (open → workerSelected), iki taraflı
    // tamamlama onayı ve şikayet (disputed) geçişleri doğrulanırdı. O akış
    // 2026-08-08'de kaldırıldı; kurallar da 2026-08-09'da sadeleşti.
    // Durum yalnız üç değer alır: open · cancelled · expired.
    match /jobs/{jobId} {
      function isJobOwner() {
        return isSignedIn() && resource.data.customerId == request.auth.uid;
      }

      allow read: if true;

      // create allowlist — kaldırılmış iş akışı alanları (offerCount,
      // selected*, chatId, *ConfirmedDone, dispute*) artık YAZILAMAZ.
      // İstemci zaten göndermiyor; allowlist onu kural düzeyinde de kapatır.
      function jobCreateKeysOk() {
        return request.resource.data.keys().hasOnly([
          'customerId', 'customerName', 'customerPhotoURL',
          'title', 'description', 'category', 'productCategoryCode',
          'province', 'district', 'neighborhood',
          'photos', 'priceType', 'budget',
          'status', 'cancelReason',
          'createdAt', 'expiresAt', 'expiresAtMs', 'moderationHidden'
        ]);
      }

      // AÇIK İLAN LİMİTİ (5). Kural motoru count() yapamaz → sayaç
      // `users/{uid}/private/jobStats.openCount` içinde denormalize tutulur ve
      // yalnız CF yazar (onJobWritten). Doküman yoksa (ilk ilan) limit geçilir.
      //
      // Neden gerekli: yayınlanan her ilan EŞLEŞEN TÜM USTALARA bildirim
      // gönderir; limitsiz kullanıcı platform çapında spam üretebilirdi.
      // Günlük hak (10) CF tarafında kesilir — kural gün bilgisi tutamaz.
      function openJobQuotaOk() {
        let p = /databases/$(database)/documents/users/$(request.auth.uid)/private/jobStats;
        return !exists(p) || get(p).data.get('openCount', 0) < 5;
      }

      // moderationHidden yalnız false veya yok (gizleme CF); true ile create yok.
      // E-posta doğrulama zorunlu (müşteri ilan açma).
      allow create: if isSignedIn()
        && !isSuspended()
        && isEmailVerified()
        && openJobQuotaOk()
        && jobCreateKeysOk()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && (!('photos' in request.resource.data)
            || (request.resource.data.photos is list
                && request.resource.data.photos.size() <= 8))
        && (!('moderationHidden' in request.resource.data)
            || request.resource.data.moderationHidden == false)
        && !request.resource.data.keys()
              .hasAny(['moderatedBy', 'moderatedAt', 'adminModerationNote']);

      // Sahip iki şey yapabilir:
      //  A) İlanı kapatmak (cancelled) — durum + iptal nedeni.
      //  B) AÇIK ilanın içeriğini düzenlemek — yalnız üç alan. 1 saatlik
      //     pencere istemcide kesilir (createdAt ISO string; kural zaman
      //     aritmetiği yapamaz), asıl koruma "yalnız open + yalnız içerik".
      //
      // `expired` istemciye KAPALI: süre dolumu okuma anında hesaplanır
      // (Job.effectiveStatus) ya da CF yazar — kullanıcı ilanını "süresi
      // dolmuş" gösterip listeden gizleyemesin.
      allow update: if !isSuspended()
        && isJobOwner()
        && ((changedOnly(['status', 'cancelReason'])
              && request.resource.data.status == 'cancelled')
            || (resource.data.status == 'open'
                && changedOnly(['title', 'description', 'budget'])));

      // Sahip ilanını her zaman silebilir. Usta ataması / tamamlanmış iş
      // kaydı diye bir şey yok; sohbetler ilandan bağımsız yaşar, silme
      // mesaj geçmişini götürmez.
      allow delete: if isJobOwner();
    }
    // ------------------------------------------------------------------
    // MAĞAZA — ürün vitrini. PRD-006 olarak kurulmuş, 2026-08-08'de
    // kaldırılmış, 2026-08-10'da Mağaza adıyla geri getirilmiştir.
    // Bkz. vault/06-Test/PLAN-Magaza.md
    //
    // USTA ŞARTI YOK (kullanıcı kararı "herkes satabilir"): ölçüt
    // oturum + e-posta doğrulaması + askıda olmamak. Moderasyon yükü
    // bu yüzden yüksek — sunucu alanları istemciye tamamen kapalı.
    //
    // İki eksenli görünürlük: (1) status, (2) moderationHidden.
    // Yayına geçiş (active) İSTEMCİDEN YAPILAMAZ — yalnız publishProduct
    // CF'i status'ü active'e çeker (ownerNeverPublishesViaStatus).
    match /products/{productId} {
      function productClientKeysOk() {
        // Create ve update merge sonrası tüm anahtarlar bu listede olmalı.
        return request.resource.data.keys().hasOnly([
          'schemaVersion', 'ownerUid', 'ownerName', 'ownerPhotoURL',
          'title', 'titleFold', 'description', 'categoryCode',
          'tags', 'tagsFold', 'photos', 'priceType', 'priceAmount',
          'currency', 'condition', 'quantity', 'province', 'district',
          'status', 'moderationHidden', 'createdAt', 'updatedAt',
          'soldAt', 'removedAt', 'removedBy', 'removedReason',
          'hiddenByModeration', 'hiddenByUserSuspend', 'hiddenByArtisanHide',
          'featured', 'publishedAt', 'reportCount', 'viewCount',
          'moderatedBy', 'moderatedAt', 'adminModerationNote',
          'moderationNote'
        ]);
      }
      function productServerFieldsLocked() {
        return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'moderationHidden', 'hiddenByModeration', 'hiddenByUserSuspend',
              'hiddenByArtisanHide', 'featured', 'publishedAt', 'reportCount',
              'viewCount', 'moderatedBy', 'moderatedAt', 'adminModerationNote',
              'moderationNote', 'ownerUid', 'createdAt', 'schemaVersion'
            ]);
      }
      function productContentUnchanged() {
        return request.resource.data.get('title', '') == resource.data.get('title', '')
          && request.resource.data.get('description', '') == resource.data.get('description', '')
          && request.resource.data.get('categoryCode', '') == resource.data.get('categoryCode', '')
          && request.resource.data.get('photos', []) == resource.data.get('photos', []);
      }
      // Draft'ta içerik serbest; diğer status'larda content yalnız CF.
      function productContentDraftOnly() {
        return resource.data.status == 'draft'
          || productContentUnchanged();
      }
      function ownerStatusTransitionOk() {
        let from = resource.data.status;
        let to = request.resource.data.status;
        return (from == 'draft' && to == 'draft')
          || (from == 'draft' && to == 'removed')
          || (from == 'pending_review' && to == 'removed')
          || (from == 'active' && to in
              ['active', 'paused', 'out_of_stock', 'sold', 'removed'])
          || (from == 'paused' && to in ['paused', 'active', 'removed'])
          || (from == 'out_of_stock' && to in
              ['out_of_stock', 'active', 'removed'])
          || (from == 'sold' && to in ['sold', 'removed'])
          || (from == 'removed' && to == 'draft');
      }
      function ownerNeverPublishesViaStatus() {
        return !(request.resource.data.status == 'active'
            && resource.data.status in ['draft', 'pending_review']);
      }
      function ownerSoftDeleteFieldsOk() {
        return request.resource.data.status != 'removed'
          || (request.resource.data.removedBy == 'owner'
              && request.resource.data.removedAt is string);
      }
      function ownerRestoreOk() {
        return request.resource.data.status != 'draft'
          || resource.data.status != 'removed'
          || resource.data.get('removedBy', '') == 'owner';
      }
      function pendingReviewLocked() {
        return resource.data.status != 'pending_review'
          || (request.resource.data.status == 'removed'
              && request.resource.data.removedBy == 'owner'
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'removedAt', 'removedBy',
                    'removedReason', 'updatedAt']));
      }
      function productFieldsBasicOk() {
        return request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 80
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 2000
          && request.resource.data.photos is list
          && request.resource.data.photos.size() <= 8
          && request.resource.data.priceType in
              ['fixed', 'negotiable', 'from']
          && request.resource.data.condition in
              ['new', 'like_new', 'used', 'handmade']
          && request.resource.data.province is string
          && request.resource.data.province.size() <= 40
          && request.resource.data.updatedAt is string
          && request.resource.data.ownerName is string
          && request.resource.data.ownerName.size() >= 1
          && request.resource.data.ownerName.size() <= 60;
      }

      allow read: if true;
      // Create: yalnız draft; moderationHidden zorunlu false.
      // TASLAK KOTASI (100). Yayınlama tarafı iyi korunuyordu (publishProduct
      // CF'inde 10/gün + 50 aktif ürün), ama TASLAK yazımı doğrudan Firestore'a
      // gidiyor ve adet sınırı yoktu: doğrulanmış e-postalı bir hesap SDK ile
      // döngüde yüz binlerce taslak yazıp hem veritabanını şişirebilir hem her
      // yazımda `onProductWritten` tetikleyip CF faturası üretebilirdi.
      // `jobs`taki `openJobQuotaOk` deseninin aynısı: sayaç
      // `users/{uid}/private/productStats.draftCount` içinde durur, yalnız CF
      // yazar (onProductWritten). Doküman yoksa (ilk ürün) limit geçilir.
      // Normal kullanıcı bu tavana hiç yaklaşmaz.
      function productDraftQuotaOk() {
        let p = /databases/$(database)/documents/users/$(request.auth.uid)/private/productStats;
        return !exists(p) || get(p).data.get('draftCount', 0) < 100;
      }

      allow create: if isSignedIn()
        && !isSuspended()
        && isEmailVerified()
        && productDraftQuotaOk()
        && productClientKeysOk()
        && productFieldsBasicOk()
        && request.resource.data.status == 'draft'
        && request.resource.data.moderationHidden == false
        && request.resource.data.createdAt is string
        && request.resource.data.schemaVersion == 1;
      // Update: sahibi + sunucu alanları kilitli + geçiş allowlist.
      allow update: if isSignedIn()
        && !isSuspended()
        && isEmailVerified()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && productClientKeysOk()
        && productServerFieldsLocked()
        && productFieldsBasicOk()
        && ownerStatusTransitionOk()
        && ownerNeverPublishesViaStatus()
        && ownerSoftDeleteFieldsOk()
        && ownerRestoreOk()
        && pendingReviewLocked()
        && productContentDraftOnly();
      allow delete: if false;
    }

    // reports — içerik/kullanıcı şikayetleri (UGC politikası, admin kuyruğu).
    // YALNIZCA oluşturma/güncelleme (kendi şikayeti, deterministik ID:
    // {targetType}_{targetId}__{reporterUid} → hedef başına şikayetçi başına
    // TEK kayıt, kuyruk şişirilemez). Okuma/silme kapalı — admin fazında
    // custom claim ile açılacak.
    match /reports/{reportId} {
      function reportOk() {
        return request.resource.data.reporterUid == request.auth.uid
          && request.resource.data.targetType in
              ['message', 'job', 'user', 'staffWorker', 'staffNeed', 'product']
          && request.resource.data.targetId is string
          && request.resource.data.reason is string
          && request.resource.data.status == 'open'
          && reportId == request.resource.data.targetType + '_'
              + request.resource.data.targetId + '__' + request.auth.uid;
      }

      allow create: if isSignedIn() && !isSuspended() && reportOk()
        // Yönetici alanları istemciden seed edilemez.
        // evidence*: yalnız adminModerateMessage CF yazar — şikayetçi sahte
        // "kaldırılan mesaj" kanıtı uyduramaz.
        && !request.resource.data.keys().hasAny(
            ['resolvedBy', 'resolvedAt', 'resolutionNote',
             'assignedTo', 'assignedAt',
             'evidenceText', 'evidenceHasImage', 'evidenceCapturedAt']);
      // Tekrar şikayet: yalnız HÂLÂ open kayıtlarda (çözülmüş kuyruk
      // üzerine set ile status=open yazılamaz — S-REPORT-1).
      allow update: if isSignedIn()
        && !isSuspended()
        && resource.data.reporterUid == request.auth.uid
        && resource.data.get('status', 'open') == 'open'
        && reportOk()
        && request.resource.data.targetType == resource.data.targetType
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.reporterUid == resource.data.reporterUid
        // evidence*: yalnız adminModerateMessage CF yazar — şikayetçi sahte
        // "kaldırılan mesaj" kanıtı uyduramaz.
        && !request.resource.data.keys().hasAny(
            ['resolvedBy', 'resolvedAt', 'resolutionNote',
             'assignedTo', 'assignedAt',
             'evidenceText', 'evidenceHasImage', 'evidenceCapturedAt']);
      // Okuma yalnız yöneticiye (admin kuyruğu); silme kapalı.
      allow read: if isAdmin();
      allow delete: if false;
    }

    // adminAuditLogs — değiştirilemez yönetici denetim kaydı. Yalnız Cloud
    // Functions (Admin SDK) YAZAR (istemci hiç yazamaz); yalnız yönetici OKUR.
    // Hesap verebilirlik + KVKK/GDPR + anlaşmazlık savunması.
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // adminRoles — yönetici kadrosu (RBAC roster). Yalnız CF (Admin SDK) yazar;
    // yalnız yönetici okur (rol atama ekranı bir kullanıcının mevcut rolünü
    // buradan okur — başka kullanıcının Auth claim'i istemciden görülemez).
    match /adminRoles/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // adminInvites — moderatör davetleri (e-posta PII). Yalnız CF yazar;
    // yalnız superadmin okur (K19).
    match /adminInvites/{inviteId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // adminStats — KPI sayaçları (global + daily). Yalnız CF yazar; admin okur.
    match /adminStats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
      match /{sub=**} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // adminConfig — runtime bayrakları (premium beta, bakım…). CF yazar.
    // Okuma herkese açık (hassas veri yok; tüketici M7 remote bayrak okur).
    match /adminConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // adminRateLimits — CF rate-limit sayaçları (transcript vb.). İstemci yok.
    match /adminRateLimits/{uid} {
      allow read, write: if false;
    }

    // membershipPurchases — Play abonelik kanıtı (token). Yalnız CF (Admin SDK).
    match /membershipPurchases/{uid} {
      allow read, write: if false;
    }

    // membershipTokens/{tokenHash} — bir Play satın alma token'ının SAHİBİ.
    // Aynı token'ın ikinci bir hesaba premium vermesini engeller
    // (grantArtisanPremium içindeki transaction). Yalnız CF (Admin SDK);
    // istemci okuyabilseydi hangi token'ın kullanıldığı sızardı.
    match /membershipTokens/{tokenHash} {
      allow read, write: if false;
    }

    // premiumOverrides — yöneticinin MANUEL premium tanımlama/iptal izi
    // (gerekçe + aktör + süre). Yalnız CF (adminGrantPremium) yazar; istemci
    // hiçbir koşulda okuyamaz/yazamaz — para etkili müdahale kaydıdır.
    match /premiumOverrides/{entryId} {
      allow read, write: if false;
    }

    // adminUserNotes — dahili moderasyon notları. KULLANICI GÖREMEZ (hakkında
    // yazılanları okuyamamalı); adminler yalnız CF üzerinden okur/yazar.
    match /adminUserNotes/{noteId} {
      allow read, write: if false;
    }

    // supportTickets — kullanıcı destek talepleri.
    // Create/update: CF (createSupportTicket / adminUpdateSupportTicket).
    // Okuma: admin veya kendi talebi. İstemci yazamaz (sahte durum yok).
    match /supportTickets/{ticketId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // scheduledCampaigns — zamanlanmış bildirim kampanyaları (yalnız CF yazar).
    match /scheduledCampaigns/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // favorites — müşterinin takip ettiği ("Takip Et") ustalar (#14). Döküman
    // ID'si = customerUid__artisanUid. Müşteri kendi listesini, USTA da kendi
    // takipçilerini okuyabilir (bildirim ekranı "Sizi Takip Edenler" — ürün
    // kararı: takip, ustaya görünürdür; UI dili de "Takip Et"). Toggle =
    // create/delete (update yok).
    match /favorites/{favId} {
      // resource == null: takip eklerken "önce oku" adımı (var olmayan döküman).
      // M5: docId = customerUid__artisanUid (spam random id yok).
      allow read: if isSignedIn()
        && (resource == null
            || resource.data.customerUid == request.auth.uid
            || resource.data.artisanUid == request.auth.uid);
      allow create: if isSignedIn()
        && !isSuspended()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.artisanUid is string
        && request.resource.data.artisanUid != request.auth.uid
        && favId == request.resource.data.customerUid + '__'
            + request.resource.data.artisanUid;
      allow delete: if isSignedIn()
        && !isSuspended()
        && resource.data.customerUid == request.auth.uid;
      allow update: if false;
    }
  }
}
